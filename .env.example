# Nexus WMS - Environment Configuration Example
# Copy this file to .env for local overrides

# Application Mode
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
VITE_APP_TITLE="Sai's Smart Warehouse Autonomous OS"

# Facility Hub Endpoints (Demo Mode)
VITE_KAKINADA_HUB_ID=KAKINADA
VITE_VIJAYAWADA_HUB_ID=VIJAYAWADA

# Security & Session Policy
VITE_SESSION_TIMEOUT_MINUTES=60
VITE_ENABLE_RATE_LIMITING=true
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION_SECONDS=30

# Simulation Configuration
VITE_DEFAULT_SIMULATION_SPEED=1
VITE_AGV_FLEET_SIZE=4
